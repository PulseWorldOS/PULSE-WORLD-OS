{
  "functions": {
    "source": "PULSE-SERVER/FIREBASE",
    "codebase": "default",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" install",
      "npm --prefix \"$RESOURCE_DIR\" run lint || echo \"Lint skipped\""
    ]
  },
  "hosting": {
    "public": "PULSE-MULTIVERSE",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/Backup.html"
      }
    ]
  }
}
