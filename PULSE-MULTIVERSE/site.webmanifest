{
  "name": "PulseWorld OS",
  "short_name": "PulseWorld",
  "description": "PulseWorld — Temporal OS, Unified Internet, Adaptive Routing, Immortal Runtime.",

  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",

  "background_color": "#000000",
  "theme_color": "#000000",

  "icons": [
    {
      "src": "./_EXPRESSIONS/_PEX/BUILD/PulseWorldOSLogo.webp.pex",
      "sizes": "192x192",
      "type": "application/octet-stream",
      "purpose": "any"
    },
    {
      "src": "./_EXPRESSIONS/_PEX/BUILD/PulseWorldOSLogo.webp.pex",
      "sizes": "256x256",
      "type": "application/octet-stream",
      "purpose": "any"
    },
    {
      "src": "./_EXPRESSIONS/_PEX/BUILD/PulseWorldOSLogo.webp.pex",
      "sizes": "384x384",
      "type": "application/octet-stream",
      "purpose": "any"
    },
    {
      "src": "./_EXPRESSIONS/_PEX/BUILD/PulseWorldOSLogo.webp.pex",
      "sizes": "512x512",
      "type": "application/octet-stream",
      "purpose": "any"
    },

    {
      "src": "./_EXPRESSIONS/_PICTURES/PulseWorldSplash512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "actions": [
    {
      "action": "open-settings",
      "title": "Settings",
      "icon": "./_EXPRESSIONS/_PICTURES/PulseSettingsIcon.png"
    },
    {
      "action": "open-profile",
      "title": "Profile",
      "icon": "./_EXPRESSIONS/_PICTURES/PulseProfileIcon.png"
    }
  ],

  "shortcuts": [
    {
      "name": "PulseWorld OS Backup",
      "short_name": "Drift Realities",
      "description": "Open PulseWorld Reality Layer instantly.",
      "url": "/?Impulse=PulseWorldReality",
      "icons": [
        {
          "src": "./_EXPRESSIONS/_PICTURES/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Pulse World OS Inventory",
      "short_name": "Open Inventory",
      "description": "Launch PulseWorld in Inventory.",
      "url": "/?Impulse=PulseWorldInventory",
      "icons": [
        {
          "src": "./_EXPRESSIONS/_PICTURES/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Pulse World OS Scanner",
      "short_name": "Open Scanner",
      "description": "Launch PulseWorld Scanner.",
      "url": "/?Impulse=PulseWorldScanner",
      "icons": [
        {
          "src": "./_EXPRESSIONS/_PICTURES/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "PulseWorld OS Business",
      "short_name": "Drift Realities",
      "description": "Open PulseWorld Reality Layer instantly.",
      "url": "/?Impulse=PulseWorldBusiness",
      "icons": [
        {
          "src": "./_EXPRESSIONS/_PICTURES/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "System Diagnostics",
      "short_name": "Diagnostics",
      "description": "Run PulseWorld System Diagnostics.",
      "url": "?Impulse=PulseWorldDiagonostics",
      "icons": [
        {
          "src": "./_EXPRESSIONS/_PICTURES/PulseDiagnosticsIcon.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }

  ],

  "prefer_related_applications": false,

  "serviceworker": {
    "src": "/DriftCompanion.js",
    "scope": "/",
    "update_via_cache": "none"
  },

  "categories": [
    "utilities",
    "productivity",
    "system",
    "browser",
    "os"
  ]
}
