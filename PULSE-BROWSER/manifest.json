{
  "manifest_version": 3,
  "name": "PulseBrowser OS",
  "short_name": "PulseBrowser",
  "description": "PulseBrowser OS — Unified Internet • Temporal OS • Accelerated Routing • Immortal Runtime • Perpetual Freshness",
  "version": "12.5.0",

  "icons": {
    "16": "PulseWorldSplash512.png",
    "32": "PulseWorldSplash512.png",
    "48": "PulseWorldSplash512.png",
    "128": "PulseWorldSplash512.png",
    "256": "PulseWorldSplash512.png"
  },

  "action": {
    "default_title": "PulseBrowser OS",
    "default_popup": "PBPopup.html",
    "default_icon": "PulseWorldSplash512.png"
  },

  "background": {
    "service_worker": "PBCompanion.js",
    "type": "module"
  },

  "options_ui": {
    "page": "PBSettings.html"
  },

  "chrome_url_overrides": {
    "newtab": "PBFrontPage.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["PBContent.js"],
      "run_at": "document_start"
    }
  ],

  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "webNavigation",
    "activeTab",
    "notifications",
    "declarativeNetRequest"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "pulseworld_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "commands": {
    "open_pulseworld": {
      "suggested_key": {
        "default": "Ctrl+Shift+P"
      },
      "description": "Open PulseWorld OS"
    },
    "pulse_accelerate_tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Force‑accelerate current tab"
    }
  },

  "web_accessible_resources": [
  {
    "resources": [
      "PulseWorldOSLogo.png",
      "PulseWorldSplash512.png",
      "android-chrome-192x192.png",
      "PulseWorldEntrancePulseGPUPulseEarn.png",
      "PBFrontPage.js",
      "PBNavigator.js",
      "PBInterceptor.js",
      "PBRouter.js",
      "PBPopup.js",      
      "PBCompanion.js",
      "PBSettings.js"
    ],
    "matches": ["<all_urls>"]
  }
],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
